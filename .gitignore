node_modules/

# Vite's built output — generated by `npm run build`, not committed.
public/dist/

# Real location + smart-home-dashboard URL — config.example.json is the
# committed template, this is your actual machine's config.
config/config.json

# Tasks and links are this device's own data, not the app's.
data/

# Locally-generated LAN HTTPS cert (mkcert) — private key + machine/IP
# specific, never committed. Run `npm run cert:lan` to (re)generate.
certs/
